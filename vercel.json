{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend,mock_service,data/documents,data/evaluation}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!assets/|shots/|favicon.svg|luminous-inquiry.png).*)", "destination": "/index.html" }
  ]
}
