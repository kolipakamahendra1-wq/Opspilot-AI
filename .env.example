# Copy to .env and adjust. Never commit .env.

# Demo account passwords (seeded on first start)
ADMIN_PASSWORD=admin123
SUPPORT_PASSWORD=support123

# Change this for any shared deployment
JWT_SECRET=change-me-to-a-long-random-string

# LLM: "ollama" (local, free) or "rules" (deterministic, no LLM)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Any OpenAI-compatible endpoint works, e.g. a hosted free model:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=...
# LLM_COST_PER_1K_TOKENS=0

# Embeddings: "ollama" (nomic-embed-text) or "hash" (offline, CI)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

RATE_LIMIT_PER_MINUTE=120
